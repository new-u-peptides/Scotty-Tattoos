# scottymassa.com - enquiry funnel configuration
#
# The site is built to run with NONE of these set: pages render, the enquiry
# form renders, and a submission fails with a polite message rather than a
# stack trace. Each block below says what stops working without it.

# ---------------------------------------------------------------------------
# MailerSend - the only email provider in this repo.
# Without these, no email is sent at all: an enquiry submission answers 502 and
# tells the visitor to email the studio directly. This is the one block you
# genuinely cannot run the funnel without.
# ---------------------------------------------------------------------------
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=booking@scottymassa.com
MAILERSEND_FROM_NAME=Scotty Massa

# The verified sending domain's ID. Not needed to send; used for diagnostics.
MAILERSEND_DOMAIN_ID=

# Signs the activity webhook. Without it POST /api/mailersend/webhook rejects
# every request with 503 - it fails closed rather than trusting unsigned
# events - so opens, clicks and bounces are never recorded.
MAILERSEND_WEBHOOK_SECRET=

# Where completed enquiries land. Defaults to studio@scottymassa.com.
BOOKING_NOTIFY_EMAIL=studio@scottymassa.com

# ---------------------------------------------------------------------------
# Signing - resume links and unsubscribe links in emails.
# Without it, verifyRef() fails closed: a "continue your enquiry" link still
# opens the form but cannot re-attach to the existing enquiry, so finishing it
# creates a second record instead of completing the first. Any long random
# string; rotating it invalidates links already sent.
# ---------------------------------------------------------------------------
ENQUIRY_LINK_SECRET=

# ---------------------------------------------------------------------------
# Supabase - optional persistence.
# Without these the funnel runs email-only: every enquiry still reaches the
# studio inbox and nothing is lost, but there is no admin board, no lifecycle
# history and no automated follow-ups. Run
# supabase/migrations/0001_enquiries.sql first.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security - server-side only,
# never in client code.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin board at /admin/enquiries.html.
# Without it GET/PATCH /api/enquiries answers 503 and the board cannot be
# opened - it is never accessible by default. Any long random string.
# ---------------------------------------------------------------------------
ADMIN_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Vercel Cron. Vercel sets this itself; the value must match the project's
# cron secret. Without it the daily follow-up job answers 503 and the 24-hour
# and 4-day reminders never send.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional - switch one template from the repo HTML to a MailerSend-hosted
# template with the same variables. Leave unset to send the file in
# emails/templates/. One per template name:
# ---------------------------------------------------------------------------
# MAILERSEND_TEMPLATE_SM_ENQUIRY_RECEIVED=
# MAILERSEND_TEMPLATE_SM_ENQUIRY_PROCESS=
# MAILERSEND_TEMPLATE_SM_ENQUIRY_REMINDER_01=
# MAILERSEND_TEMPLATE_SM_ENQUIRY_REMINDER_02=
# MAILERSEND_TEMPLATE_SM_ENQUIRY_APPLICATION_RECEIVED=
# MAILERSEND_TEMPLATE_SM_ENQUIRY_CONSULTATION=
# MAILERSEND_TEMPLATE_SM_BOOKING_CONFIRMED=
# MAILERSEND_TEMPLATE_SM_DEPOSIT_REMINDER=
# MAILERSEND_TEMPLATE_SM_SESSION_REMINDER=
# MAILERSEND_TEMPLATE_SM_INTERNAL_NEW_ENQUIRY=
